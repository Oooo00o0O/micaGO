<Page
    x:Class="MicaGo.App.Views.HiddenContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:MicaGo.App"
    xmlns:models="using:MicaGo.Core.Models">

    <Grid Background="Transparent">
        <Grid MaxWidth="1000" Margin="36,12,36,24" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,4,0,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource MicaGoIconButtonStyle}" Click="BackButton_Click">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="Hidden contacts" />
                <Button x:Name="SelectButton" Grid.Column="2" Style="{StaticResource MicaGoIconButtonStyle}" Click="SelectButton_Click">
                    <FontIcon FontSize="16" Glyph="&#xE762;" />
                </Button>
                <Button x:Name="SelectAllButton" Grid.Column="3" Style="{StaticResource MicaGoIconButtonStyle}" Visibility="Collapsed" Click="SelectAllButton_Click">
                    <FontIcon FontSize="16" Glyph="&#xE8B3;" />
                </Button>
                <Button x:Name="CancelSelectionButton" Grid.Column="4" Style="{StaticResource MicaGoIconButtonStyle}" Visibility="Collapsed" Click="CancelSelectionButton_Click">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <!-- W-UI9 (Flutter C83): the hidden-chat sync status is the last item of the
                 scrolling content and only appears when there is something to act on. -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <StackPanel x:Name="EmptyState" Margin="0,48,0,0" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
                    <FontIcon HorizontalAlignment="Center" FontSize="42" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE77B;" />
                    <TextBlock x:Name="EmptyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No hidden contacts" />
                </StackPanel>
                <StackPanel x:Name="ListPanel" Spacing="8">
                    <TextBlock x:Name="CountText" Style="{StaticResource MicaGoSettingsHeaderStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ListView x:Name="HiddenContactsList"
                                  Background="Transparent"
                                  IsItemClickEnabled="True"
                                  ItemClick="HiddenContactsList_ItemClick"
                                  ItemContainerStyle="{StaticResource MicaGoChatListStyle}"
                                  ContainerContentChanging="HiddenContactsList_ContainerContentChanging"
                                  SelectionChanged="HiddenContactsList_SelectionChanged"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ChatSummary">
                                    <Grid MinHeight="64" Padding="10,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PersonPicture Width="42" Height="42" DisplayName="{x:Bind Title}" ProfilePicture="{x:Bind app:Ui.Image(AvatarPath)}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ServiceLabel}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button x:Name="RestoreOneButton"
                                                Grid.Column="2"
                                                Style="{StaticResource MicaGoIconButtonStyle}"
                                                Tag="{x:Bind Id}"
                                                Click="RestoreOneButton_Click">
                                            <FontIcon FontSize="16" Glyph="&#xE890;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="PreferencePanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="PreferenceStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="8">
                        <Button x:Name="ImportPreferencesButton" Click="ImportPreferences_Click" />
                        <Button x:Name="RetryPreferencesButton" Click="RetryPreferences_Click" />
                        <Button x:Name="ServerPreferencesButton" Click="ServerPreferences_Click" />
                        <Button x:Name="MinePreferencesButton" Click="MinePreferences_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="8">
                <InfoBar x:Name="RestoreInfoBar" IsOpen="False" IsClosable="True" Severity="Success" />
                <Button x:Name="RestoreSelectedButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed"
                        Click="RestoreSelectedButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
